</div>

<div class="card">
    <div class="card-header">1. ESTADO DE CUENTA BANECUADOR B.P. - {{ $cierre->num_transacciones ?? 7 }} TRANSACCIONES</div>
    <div class="card-body" style="padding:0;">
        <table class="table" style="margin:0;">
            <thead>
                <tr><th>FECHA</th><th>DESCRIPCION</th><th>REFERENCIA</th><th>DEBITO</th><th>S. CONTABLE</th><th>S. DISPONIBLE</th></tr>
            </thead>
            <tbody>
                <tr class="bg-gray"><td colspan="3"><strong>Saldo Inicial Real {{ $cierre->fecha_cierre ? $cierre->fecha_cierre->copy()->subMonth()->format('d/m/Y') : '01/09/2026' }} - Cuenta {{ $cierre->cuenta_bancaria ?? '3-00167809' }}-0:</strong></td><td></td><td class="text-right" style="font-weight:900;">${{ number_format($cierre->saldo_inicial_banco ?? 9999.34,2) }}</td><td class="text-right" style="font-weight:900;">${{ number_format($cierre->saldo_inicial_banco ?? 9999.34,2) }}</td></tr>
                @php $saldo = $cierre->saldo_inicial_banco ?? 9999.34; @endphp
                @foreach(($cierre->detalle_transacciones ?? []) as $t)
                    @php
                        $fecha = $t['fecha'] ?? $t['fecha_transaccion'] ?? date('Y-m-d');
                        $desc = $t['descripcion'] ?? $t['desc'] ?? $t['detalle'] ?? $t['concepto'] ?? $t['descripcion_banco'] ?? 'Transacción';
                        $ref = $t['referencia'] ?? $t['ref'] ?? '';
                        $debito = $t['debito'] ?? $t['valor'] ?? $t['monto'] ?? 0;
                        $saldo -= $debito;
                    @endphp
                    <tr><td>{{ date('d/m/Y',strtotime($fecha)) }}</td><td>{{ $desc }}</td><td>{{ $ref }}</td><td class="text-right">${{ number_format($debito,2) }}</td><td class="text-right">${{ number_format($saldo,2) }}</td><td class="text-right">${{ number_format($saldo,2) }}</td></tr>
                @endforeach
                <tr class="bg-dark"><td colspan="3" style="text-align:right; font-weight:900;">TOTALES - {{ $cierre->num_transacciones ?? 7 }} TRANSACCIONES:</td><td style="text-align:right; font-weight:900;">${{ number_format($cierre->total_debitos_banco ?? 9568.45,2) }}</td><td></td><td></td></tr>
            </tbody>
        </table>
        <div style="background:#f2f2f2; border:1px solid #000; padding:6px; font-size:9px; font-weight:700; margin:5px;">
