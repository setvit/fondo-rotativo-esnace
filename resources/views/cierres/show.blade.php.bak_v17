    <p>Código: {{ $cierre->codigo ?? 'ESNACE-COOPNA-FR-2026-09' }} | Fecha: {{ $cierre->fecha_cierre ? $cierre->fecha_cierre->format('d/m/Y') : '06/10/2026' }} | Cuenta: {{ $cierre->cuenta_bancaria ?? '3-00167809-0' }} | Saldo: ${{ number_format($cierre->saldo_final_banco ?? 431.55,2) }}</p>
